[Unit]
Description=AP Chemistry Account Server (account-server)
After=network.target

[Service]
Type=simple
# 运行用户：请按需改成实际账号（建议专用非 root 用户）
User=apchem
Group=apchem
WorkingDirectory=/srv/apchemistry/account-server
ExecStart=/usr/bin/node server.js
Environment=PORT=8787
# 服务异常时自动重启
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
